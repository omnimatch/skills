  "narrative": {
    "northStar": "The research radar",
    "overview": "A quiet navy canvas, a lilac comparison plot and a browsable collection whose evidence remains close at hand. The interface is compact enough for sustained investigation. Hierarchy comes from typography, spacing and selection; concise headings and concrete controls carry the workflow. Unknown evidence remains visible in the chart and assessment.",
    "keyCharacteristics": [
      "Dark tonal surfaces with one lilac selection accent.",
      "A readable radar paired with bounded, browsable results.",
      "Plain labels, visible source evidence and tabular scores.",
      "Keyboard access, reduced motion and a light print treatment."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Use color to support an explicit label. Unknown scores are written as Unknown and leave gaps in the radar.",
        "section": "colors"
      },
      {
        "name": "The Plain Heading Rule",
        "body": "Lead with a concise title. Add supporting text when it explains evidence, scope or a recovery action.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep selected state, evidence coverage and unknown facts distinguishable in text as well as color.",
      "Do preserve bounded scrolling and incremental result loading.",
      "Do keep the offline report self-contained, including its font and interaction code.",
      "Do provide a visible focus outline and honor reduced motion.",
      "Do keep source evidence available beside its assessment."
    ],
    "donts": [
      "Do not turn unknown values into zero scores or close their radar gaps.",
      "Do not add shadows, excessive cards or decorative accents that weaken the tonal hierarchy.",
      "Do not let result histories or evidence excerpts grow the page without bounds.",
      "Do not add repetitive supporting copy beneath every heading.",
      "Do not hide a capped radar population behind a claim that every result is plotted."
    ]
  }
}
