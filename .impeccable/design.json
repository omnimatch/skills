      "css": ".ds-row-demo{font-family:\"Space Grotesk\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:14px;line-height:1.55;background:var(--background,#0d1020);color:var(--foreground,#f4f2ec);padding:20px;}.ds-row{font:inherit;display:flex;align-items:center;text-align:left;width:100%;min-height:104px;padding:17px 12px;gap:13px;border:0;border-bottom:1px solid var(--border,#30354c);border-radius:0;color:inherit;background:var(--surface,#15192b);cursor:pointer;transition:background .15s}.ds-row:hover{background:var(--raised,#1d2239)}.ds-row[aria-pressed=\"true\"]{background:var(--accent-soft,#29223f)}.ds-row:focus-visible{outline:2px solid var(--accent,#c3afff);outline-offset:4px}.ds-row-index{font-size:11px;color:var(--muted,#b0aec3);align-self:flex-start;padding-top:3px;font-variant-numeric:tabular-nums}.ds-row-copy{display:flex;flex-direction:column;min-width:0;flex:1}.ds-row-copy strong{font-size:14px;line-height:1.4;font-weight:550;overflow-wrap:anywhere}.ds-row-copy>span{color:var(--muted,#b0aec3);font-size:11px;margin-top:4px}.ds-row-copy small{color:var(--muted,#b0aec3);font-size:10px;margin-top:5px}.ds-row-score{font-size:25px;font-weight:450;line-height:1.15;letter-spacing:-.025em;text-align:right;min-width:33px;font-variant-numeric:tabular-nums}.ds-row-score small{display:block;color:var(--muted,#b0aec3);font-size:10px;letter-spacing:0;margin-top:3px}.ds-row>svg{color:var(--accent,#c3afff);flex-shrink:0}@media(prefers-reduced-motion:reduce){.ds-row{transition:none}}"
